# Docker 部署构建：由同一个 Nginx 域名反向代理后端接口
NODE_ENV=production
VITE_DEV=false
VITE_BASE_URL=
VITE_API_URL=/admin-api
VITE_BASE_PATH=/
VITE_OUT_DIR=dist-prod
VITE_DROP_DEBUGGER=true
VITE_DROP_CONSOLE=true
VITE_SOURCEMAP=false

# 商城 H5 会员端子路径（与 Docker Nginx 的 /h5/ location 保持一致）
VITE_MALL_H5_DOMAIN='/h5/'

# 图形验证码开关：后端 qiji.captcha.enable 在生产为 true，前端必须一致，否则登录会报“验证码不能为空”
VITE_APP_CAPTCHA_ENABLE=true

# 本地开发环境专用配置，仅用于 pnpm dev / pnpm dev:e2e（--mode localdev）
# 该文件受版本控制，保证干净检出后本地开发仍能连接本机后端；
# 生产与容器构建请使用 .env.prod / .env.docker，不要修改本文件。
NODE_ENV=development

VITE_DEV=true

# 后端地址
VITE_BASE_URL='http://localhost:48080'

# 文件上传方式：server - 后端上传；client - 前端直连上传（支持 S3 等）
VITE_UPLOAD_TYPE=server

# 接口地址
VITE_API_URL=/admin-api

# 是否删除 debugger
VITE_DROP_DEBUGGER=false

# 是否删除 console.log
VITE_DROP_CONSOLE=false

# 是否生成 sourcemap
VITE_SOURCEMAP=false

# 基础路径
VITE_BASE_PATH=/

# 商城 H5 会员端地址（本地开启会员端时，域名需要改成 3000 端口）
VITE_MALL_H5_DOMAIN='http://localhost:3000/h5/'

# 验证码开关（与后端 application-local.yaml 的 qiji.captcha.enable=false 保持一致）
VITE_APP_CAPTCHA_ENABLE=false

# GoView监控
VITE_GOVIEW_URL='http://127.0.0.1:3000'
